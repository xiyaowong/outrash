{
  "version": 1,
  "staleDays": 30,
  "groups": [
    {
      "id": "node",
      "name": "Node.js",
      "items": [
        {
          "id": "npm",
          "name": "npm 缓存",
          "note": "下次安装依赖时自动重新下载",
          "env": ["npm_config_cache"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/npm-cache"],
            "darwin": ["~/.npm"],
            "linux": ["~/.npm"]
          },
          "unit": "entries"
        },
        {
          "id": "pnpm",
          "name": "pnpm 存储",
          "note": "下次安装依赖时自动重新下载",
          "env": ["npm_config_store_dir"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/pnpm/store"],
            "darwin": ["~/Library/pnpm/store"],
            "linux": ["~/.local/share/pnpm/store"]
          },
          "unit": "entries"
        },
        {
          "id": "yarn",
          "name": "Yarn 缓存",
          "note": "下次安装依赖时自动重新下载",
          "env": ["YARN_CACHE_FOLDER"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/Yarn/Cache", "%LOCALAPPDATA%/Yarn/Berry/cache"],
            "darwin": ["~/Library/Caches/Yarn", "~/.yarn/berry/cache"],
            "linux": ["~/.cache/yarn", "~/.yarn/berry/cache"]
          },
          "unit": "entries"
        },
        {
          "id": "bun",
          "name": "Bun 缓存",
          "note": "下次安装依赖时自动重新下载",
          "env": ["BUN_INSTALL_CACHE_DIR"],
          "paths": {
            "windows": ["%USERPROFILE%/.bun/install/cache"],
            "darwin": ["~/.bun/install/cache"],
            "linux": ["~/.bun/install/cache"]
          },
          "unit": "entries"
        },
        {
          "id": "deno",
          "name": "Deno 缓存",
          "note": "下次运行时自动重新下载",
          "env": ["DENO_DIR"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/deno"],
            "darwin": ["~/Library/Caches/deno"],
            "linux": ["~/.cache/deno"]
          },
          "unit": "entries"
        },
        {
          "id": "playwright",
          "name": "Playwright 浏览器",
          "note": "可用 npx playwright install 重新下载",
          "env": ["PLAYWRIGHT_BROWSERS_PATH"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/ms-playwright"],
            "darwin": ["~/Library/Caches/ms-playwright"],
            "linux": ["~/.cache/ms-playwright"]
          },
          "unit": "entries"
        },
        {
          "id": "electron",
          "name": "Electron 二进制",
          "note": "下次安装时自动重新下载",
          "env": ["electron_config_cache"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/electron/Cache"],
            "darwin": ["~/Library/Caches/electron"],
            "linux": ["~/.cache/electron"]
          },
          "unit": "entries"
        },
        {
          "id": "cypress",
          "name": "Cypress 二进制",
          "note": "可用 npx cypress install 重新下载",
          "env": ["CYPRESS_CACHE_FOLDER"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/Cypress/Cache"],
            "darwin": ["~/Library/Caches/Cypress"],
            "linux": ["~/.cache/Cypress"]
          },
          "unit": "entries"
        }
      ]
    },
    {
      "id": "dotnet",
      "name": ".NET",
      "items": [
        {
          "id": "nuget-packages",
          "name": "NuGet 全局包",
          "note": "还原项目时自动重新下载",
          "env": ["NUGET_PACKAGES"],
          "paths": {
            "windows": ["%USERPROFILE%/.nuget/packages"],
            "darwin": ["~/.nuget/packages"],
            "linux": ["~/.nuget/packages"]
          },
          "unit": "versioned"
        },
        {
          "id": "nuget-http",
          "name": "NuGet 下载缓存",
          "note": "还原项目时自动重新下载",
          "env": ["NUGET_HTTP_CACHE_PATH"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/NuGet/v3-cache"],
            "darwin": ["~/.local/share/NuGet/v3-cache"],
            "linux": ["~/.local/share/NuGet/v3-cache"]
          },
          "unit": "entries"
        }
      ]
    },
    {
      "id": "go",
      "name": "Go",
      "items": [
        {
          "id": "go-build",
          "name": "构建缓存",
          "note": "go build 时自动重新编译",
          "env": ["GOCACHE"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/go-build"],
            "darwin": ["~/Library/Caches/go-build"],
            "linux": ["~/.cache/go-build"]
          },
          "unit": "entries"
        },
        {
          "id": "go-mod",
          "name": "模块缓存",
          "note": "构建时自动重新下载",
          "env": ["GOMODCACHE"],
          "paths": {
            "windows": ["%GOPATH%/pkg/mod", "%USERPROFILE%/go/pkg/mod"],
            "darwin": ["%GOPATH%/pkg/mod", "~/go/pkg/mod"],
            "linux": ["%GOPATH%/pkg/mod", "~/go/pkg/mod"]
          },
          "unit": "entries"
        }
      ]
    },
    {
      "id": "rust",
      "name": "Rust",
      "items": [
        {
          "id": "cargo-registry",
          "name": "Cargo 注册表",
          "note": "构建时自动重新下载",
          "paths": {
            "windows": ["%CARGO_HOME%/registry", "%USERPROFILE%/.cargo/registry"],
            "darwin": ["%CARGO_HOME%/registry", "~/.cargo/registry"],
            "linux": ["%CARGO_HOME%/registry", "~/.cargo/registry"]
          },
          "unit": "entries"
        },
        {
          "id": "cargo-git",
          "name": "Cargo Git 依赖",
          "note": "构建时自动重新下载",
          "paths": {
            "windows": ["%CARGO_HOME%/git", "%USERPROFILE%/.cargo/git"],
            "darwin": ["%CARGO_HOME%/git", "~/.cargo/git"],
            "linux": ["%CARGO_HOME%/git", "~/.cargo/git"]
          },
          "unit": "entries"
        }
      ]
    },
    {
      "id": "python",
      "name": "Python",
      "items": [
        {
          "id": "pip",
          "name": "pip 缓存",
          "note": "下次安装时自动重新下载",
          "env": ["PIP_CACHE_DIR"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/pip/cache"],
            "darwin": ["~/Library/Caches/pip"],
            "linux": ["~/.cache/pip"]
          },
          "unit": "entries"
        },
        {
          "id": "uv",
          "name": "uv 缓存",
          "note": "下次安装时自动重新下载",
          "env": ["UV_CACHE_DIR"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/uv/cache"],
            "darwin": ["~/.cache/uv"],
            "linux": ["~/.cache/uv"]
          },
          "unit": "entries"
        },
        {
          "id": "poetry",
          "name": "Poetry 缓存",
          "note": "下次安装时自动重新下载",
          "env": ["POETRY_CACHE_DIR"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/pypoetry/Cache"],
            "darwin": ["~/Library/Caches/pypoetry"],
            "linux": ["~/.cache/pypoetry"]
          },
          "unit": "entries",
          "exclude": ["virtualenvs"]
        },
        {
          "id": "conda",
          "name": "Conda 包缓存",
          "note": "下次安装时自动重新下载",
          "paths": {
            "windows": ["%USERPROFILE%/.conda/pkgs"],
            "darwin": ["~/.conda/pkgs"],
            "linux": ["~/.conda/pkgs"]
          },
          "unit": "entries"
        }
      ]
    },
    {
      "id": "ai",
      "name": "AI 模型",
      "items": [
        {
          "id": "huggingface",
          "name": "Hugging Face 模型缓存",
          "note": "下次加载模型时自动重新下载",
          "env": ["HF_HUB_CACHE", "HUGGINGFACE_HUB_CACHE"],
          "paths": {
            "windows": ["%HF_HOME%/hub", "%USERPROFILE%/.cache/huggingface/hub"],
            "darwin": ["%HF_HOME%/hub", "%XDG_CACHE_HOME%/huggingface/hub", "~/.cache/huggingface/hub"],
            "linux": ["%HF_HOME%/hub", "%XDG_CACHE_HOME%/huggingface/hub", "~/.cache/huggingface/hub"]
          },
          "unit": "entries",
          "exclude": [".locks", "blobs"]
        }
      ]
    },
    {
      "id": "jvm",
      "name": "JVM",
      "items": [
        {
          "id": "gradle",
          "name": "Gradle 缓存",
          "note": "构建时自动重新下载",
          "paths": {
            "windows": ["%GRADLE_USER_HOME%/caches", "%USERPROFILE%/.gradle/caches"],
            "darwin": ["%GRADLE_USER_HOME%/caches", "~/.gradle/caches"],
            "linux": ["%GRADLE_USER_HOME%/caches", "~/.gradle/caches"]
          },
          "unit": "entries"
        }
      ]
    },
    {
      "id": "browsers",
      "name": "浏览器",
      "items": [
        {
          "id": "edge",
          "name": "Microsoft Edge 缓存",
          "note": "下次打开网页时自动重新下载",
          "paths": {
            "windows": [
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Default/Cache",
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Profile */Cache",
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Default/Code Cache",
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Profile */Code Cache",
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Default/GPUCache",
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Profile */GPUCache",
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Default/DawnGraphiteCache",
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Default/DawnWebGPUCache",
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Default/Service Worker/CacheStorage",
              "%LOCALAPPDATA%/Microsoft/Edge/User Data/Profile */Service Worker/CacheStorage"
            ],
            "darwin": [
              "~/Library/Caches/Microsoft Edge/Default/Cache",
              "~/Library/Caches/Microsoft Edge/Profile */Cache",
              "~/Library/Caches/Microsoft Edge/Default/Code Cache",
              "~/Library/Caches/Microsoft Edge/Profile */Code Cache",
              "~/Library/Caches/Microsoft Edge/Default/GPUCache",
              "~/Library/Caches/Microsoft Edge/Profile */GPUCache"
            ],
            "linux": [
              "~/.cache/microsoft-edge/Default/Cache",
              "~/.cache/microsoft-edge/Profile */Cache",
              "~/.cache/microsoft-edge/Default/Code Cache",
              "~/.cache/microsoft-edge/Profile */Code Cache",
              "~/.cache/microsoft-edge/Default/GPUCache",
              "~/.cache/microsoft-edge/Profile */GPUCache"
            ]
          },
          "unit": "entries"
        },
        {
          "id": "chrome",
          "name": "Google Chrome 缓存",
          "note": "下次打开网页时自动重新下载",
          "paths": {
            "windows": [
              "%LOCALAPPDATA%/Google/Chrome/User Data/Default/Cache",
              "%LOCALAPPDATA%/Google/Chrome/User Data/Profile */Cache",
              "%LOCALAPPDATA%/Google/Chrome/User Data/Default/Code Cache",
              "%LOCALAPPDATA%/Google/Chrome/User Data/Profile */Code Cache",
              "%LOCALAPPDATA%/Google/Chrome/User Data/Default/GPUCache",
              "%LOCALAPPDATA%/Google/Chrome/User Data/Profile */GPUCache",
              "%LOCALAPPDATA%/Google/Chrome/User Data/Default/Service Worker/CacheStorage",
              "%LOCALAPPDATA%/Google/Chrome/User Data/Profile */Service Worker/CacheStorage"
            ],
            "darwin": [
              "~/Library/Caches/Google/Chrome/Default/Cache",
              "~/Library/Caches/Google/Chrome/Profile */Cache",
              "~/Library/Caches/Google/Chrome/Default/Code Cache",
              "~/Library/Caches/Google/Chrome/Profile */Code Cache",
              "~/Library/Caches/Google/Chrome/Default/GPUCache",
              "~/Library/Caches/Google/Chrome/Profile */GPUCache"
            ],
            "linux": [
              "~/.cache/google-chrome/Default/Cache",
              "~/.cache/google-chrome/Profile */Cache",
              "~/.cache/google-chrome/Default/Code Cache",
              "~/.cache/google-chrome/Profile */Code Cache",
              "~/.cache/google-chrome/Default/GPUCache",
              "~/.cache/google-chrome/Profile */GPUCache"
            ]
          },
          "unit": "entries"
        },
        {
          "id": "firefox",
          "name": "Firefox 缓存",
          "note": "下次打开网页时自动重新下载",
          "paths": {
            "windows": ["%LOCALAPPDATA%/Mozilla/Firefox/Profiles/*/cache2"],
            "darwin": ["~/Library/Caches/Firefox/Profiles/*/cache2"],
            "linux": ["~/.cache/mozilla/firefox/*/cache2"]
          },
          "unit": "entries"
        }
      ]
    },
    {
      "id": "editors",
      "name": "编辑器",
      "items": [
        {
          "id": "vscode",
          "name": "VS Code 缓存",
          "note": "重新打开时自动重建",
          "paths": {
            "windows": [
              "%APPDATA%/Code/Cache",
              "%APPDATA%/Code/Code Cache",
              "%APPDATA%/Code/GPUCache",
              "%APPDATA%/Code/CachedData",
              "%APPDATA%/Code/DawnGraphiteCache",
              "%APPDATA%/Code/DawnWebGPUCache",
              "%APPDATA%/Code/CachedExtensionVSIXs"
            ],
            "darwin": [
              "~/Library/Application Support/Code/Cache",
              "~/Library/Application Support/Code/Code Cache",
              "~/Library/Application Support/Code/GPUCache",
              "~/Library/Application Support/Code/CachedData",
              "~/Library/Application Support/Code/CachedExtensionVSIXs"
            ],
            "linux": [
              "~/.config/Code/Cache",
              "~/.config/Code/Code Cache",
              "~/.config/Code/GPUCache",
              "~/.config/Code/CachedData",
              "~/.config/Code/CachedExtensionVSIXs"
            ]
          },
          "unit": "entries"
        }
      ]
    },
