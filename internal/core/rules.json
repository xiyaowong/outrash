            "linux": ["%PUB_CACHE%/hosted", "%PUB_CACHE%/git", "~/.pub-cache/hosted", "~/.pub-cache/git"]
          },
          "unit": "entries"
        },
        {
          "id": "composer",
          "name": "Composer 缓存",
          "note": "下次安装时自动重新下载",
          "env": ["COMPOSER_CACHE_DIR"],
          "paths": {
            "windows": ["%LOCALAPPDATA%/Composer"],
